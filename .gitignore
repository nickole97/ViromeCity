/.quarto/
.DS_Store

# Borradores en tránsito. Ver _incoming/LEEME.md — el contenido publicable
# vive en sections/*.qmd, no aquí.
/_incoming/*
!/_incoming/LEEME.md
!/_incoming/brief-para-borradores.md

# Illustrator scratch and recovery files. assets/img/ is declared as a Quarto
# resource, so anything dropped in it is copied straight into the published
# site — a ~ai-*.tmp rode along into docs/ for eight commits before this.
~ai-*
*.tmp
